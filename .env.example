# Database (Neon PostgreSQL). Prisma reads POSTGRES_URL as its datasource.
# Use the pooled URL for the app and the non-pooling URL for `prisma migrate`.
POSTGRES_URL="postgres://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Secret that gates the /admin dashboard. Its hash authorizes the admin cookie.
ADMIN_TOKEN="choose-a-long-random-string"

# Optional: GoatCounter analytics endpoint (public, safe to expose).
NEXT_PUBLIC_GOAT_COUNTER=""
